; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="Earth Wallpaper"
run/main_scene="res://scenes/EarthWallpaper.tscn"
config/icon="res://assets/icon.svg"

[debug]

settings/fps/force_fps=30

[display]

window/size/width=720
window/size/height=1280
window/size/test_width=405
window/size/test_height=720
window/handheld/orientation=1
window/stretch/mode="2d"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_mouse_from_touch=false

[mono]

project/assembly_name="EarthWallpaper"

[rendering]

quality/driver/driver_name="GLES2"
quality/shading/force_vertex_shading.mobile=false
environment/default_clear_color=Color( 0.006, 0.012, 0.026, 1 )
